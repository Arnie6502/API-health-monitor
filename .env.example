# API Health Monitor — environment configuration
# Copy to .env and adjust. All vars are optional (sensible defaults exist).

# --- Database ----------------------------------------------------------------
# SQLite (default, zero-dependency local dev):
AHM_DATABASE_URL=sqlite+aiosqlite:///./api_health_monitor.db
# PostgreSQL (Docker / production):
# AHM_DATABASE_URL=postgresql+psycopg2://ahm:ahm@localhost:5432/ahm

# --- Scheduler ---------------------------------------------------------------
# Poll every endpoint this often (seconds).
AHM_POLL_INTERVAL_SECONDS=60
# Set to false to run the API without the background scheduler (e.g. tests).
AHM_SCHEDULER_ENABLED=true

# --- Alerting ----------------------------------------------------------------
# Raise an alert after this many consecutive failures.
AHM_CONSECUTIVE_FAILURES_THRESHOLD=3
# Per-request timeout (seconds) before a check is marked failed.
AHM_REQUEST_TIMEOUT_SECONDS=10.0
# Optional: POST alert JSON to this URL (Slack/Discord/custom webhook).
# AHM_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Bootstrap endpoints -----------------------------------------------------
# Comma-separated "Name|URL" pairs seeded on first run.
AHM_BOOTSTRAP_ENDPOINTS=Weather API|https://api.open-meteo.com/v1/forecast?latitude=52.52&longitude=13.41&current=temperature_2m,HTTPBin|https://httpbin.org/status/200
